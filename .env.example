# ============================================================================
#  .env.example  —  skabelon for hemmeligheder
# ----------------------------------------------------------------------------
#  Kopiér denne fil til ".env" og udfyld med rigtige værdier, NÅR I er klar.
#  .env må ALDRIG lægges i git (den står i .gitignore).
#  Så længe felterne er tomme, kører systemet videre i MOCK-tilstand.
# ============================================================================

# --- Personale-login ---
# Den kode personalet bruger til at logge ind på staff.html.
STAFF_ACCESS_CODE=

# --- Flatpay (betaling) ---
# Når denne er udfyldt, skifter betalingsdelen fra mock til rigtig.
FLATPAY_API_KEY=
FLATPAY_WEBHOOK_SECRET=

# --- Google Kalender ---
# ID på jeres ÉNE delte butikskalender (findes i kalenderens indstillinger).
GOOGLE_CALENDAR_ID=
# Sti til service-account nøglefilen fra Google Cloud (JSON).
GOOGLE_KEY_FILE=

# --- SMS til kunden (anbefalet: GatewayAPI — dansk) ---
# Når denne er udfyldt, sendes rigtige SMS'er i stedet for mock.
GATEWAYAPI_TOKEN=
# Kun hvis din konto bruger EU-adressen: sæt denne til https://gatewayapi.eu
GATEWAYAPI_BASE=

# --- E-mail til kunden (SMTP) ---
# Når SMTP_HOST er udfyldt, sendes rigtige e-mails i stedet for mock.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=clubfanoe@gmail.com

# --- Server ---
# Offentlig adresse når systemet er online (bruges til betalings-returlinks).
PUBLIC_URL=
PORT=3000
